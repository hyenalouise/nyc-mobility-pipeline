      "name": "739300ac",
      "displayName": "pipeline_runs",
      "config": {
        "version": "1.1",
        "source": "`ftw-week-08`.`01-control`.pipeline_runs",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "e98752b4",
      "displayName": "latest_run_status",
      "config": {
        "version": "1.1",
        "source": "SELECT status, started_at, completed_at\r\nFROM `ftw-week-08`.`01-control`.pipeline_runs\r\nORDER BY started_at DESC\r\nLIMIT 1",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "9d0cc217",
      "displayName": "recent_runs",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    run_id,\r\n    triggered_by,\r\n    started_at,\r\n    completed_at,\r\n    status\r\nFROM `ftw-week-08`.`01-control`.pipeline_runs\r\nORDER BY started_at DESC\r\nLIMIT 20",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "ce85ddca",
      "displayName": "latest_run_duration",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    run_id,\r\n    started_at,\r\n    completed_at,\r\n    (unix_timestamp(completed_at) - unix_timestamp(started_at)) AS duration_seconds\r\nFROM `ftw-week-08`.`01-control`.pipeline_runs\r\nWHERE completed_at IS NOT NULL\r\nORDER BY started_at DESC\r\nLIMIT 1",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "ef0b2b58",
      "displayName": "run_duration_trend",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    ROW_NUMBER() OVER (ORDER BY started_at ASC) AS run_seq,\r\n    run_id,\r\n    started_at,\r\n    (unix_timestamp(completed_at) - unix_timestamp(started_at)) AS duration_seconds\r\nFROM `ftw-week-08`.`01-control`.pipeline_runs\r\nWHERE completed_at IS NOT NULL\r\nORDER BY started_at ASC\r\nLIMIT 50",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "760ddc0b",
      "displayName": "latest_run_failures",
      "config": {
        "version": "1.1",
        "source": "SELECT check_name, status, fail_count, total_count, details\r\nFROM `ftw-week-08`.`01-control`.data_quality_results\r\nWHERE layer = 'control'\r\n  AND run_id = (\r\n      SELECT run_id FROM `ftw-week-08`.`01-control`.pipeline_runs\r\n      ORDER BY started_at DESC LIMIT 1\r\n  )\r\n  AND status IN ('FAIL', 'WARN')\r\nORDER BY status DESC, check_name",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "177094da",
      "displayName": "latest_run_fail_count",
      "config": {
        "version": "1.1",
        "source": "SELECT COUNT_IF(status = 'FAIL') AS fail_count\r\nFROM `ftw-week-08`.`01-control`.data_quality_results\r\nWHERE layer = 'control'\r\n  AND run_id = (\r\n      SELECT run_id FROM `ftw-week-08`.`01-control`.pipeline_runs\r\n      ORDER BY started_at DESC LIMIT 1\r\n  )",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "a18e3c00",
      "displayName": "run_recency",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    started_at,\r\n    completed_at,\r\n    (unix_timestamp(current_timestamp()) - unix_timestamp(started_at)) / 3600.0 AS hours_since_last_run\r\nFROM `ftw-week-08`.`01-control`.pipeline_runs\r\nORDER BY started_at DESC\r\nLIMIT 1",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "d1329b24",
      "displayName": "status_success_rate",
      "config": {
        "version": "1.1",
        "source": "SELECT ROUND(100.0 * COUNT_IF(status = 'SUCCESS') / COUNT(*), 1) AS success_rate_pct\r\nFROM (\r\n    SELECT status FROM `ftw-week-08`.`01-control`.pipeline_runs\r\n    ORDER BY started_at DESC LIMIT 20\r\n)",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "538eac25",
      "displayName": "avg_duration_20",
      "config": {
        "version": "1.1",
        "source": "SELECT ROUND(AVG(duration_seconds), 1) AS avg_duration_seconds\r\nFROM (\r\n    SELECT (unix_timestamp(completed_at) - unix_timestamp(started_at)) AS duration_seconds\r\n    FROM `ftw-week-08`.`01-control`.pipeline_runs\r\n    WHERE completed_at IS NOT NULL\r\n    ORDER BY started_at DESC LIMIT 20\r\n)",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "14a46ba4",
      "displayName": "runs_per_day",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    DATE(started_at) AS run_date,\r\n    COUNT(*) AS run_count\r\nFROM `ftw-week-08`.`01-control`.pipeline_runs\r\nGROUP BY DATE(started_at)\r\nORDER BY run_date",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "7a3c2243",
      "displayName": "avg_duration_per_day",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    DATE(started_at) AS run_date,\r\n    ROUND(AVG(unix_timestamp(completed_at) - unix_timestamp(started_at)), 1) AS avg_duration_seconds\r\nFROM `ftw-week-08`.`01-control`.pipeline_runs\r\nWHERE completed_at IS NOT NULL\r\nGROUP BY DATE(started_at)\r\nORDER BY run_date",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "056a4a7d",
      "displayName": "latest_run_stuck_count",
      "config": {
        "version": "1.1",
        "source": "SELECT fail_count AS stuck_runs_detected\r\nFROM `ftw-week-08`.`01-control`.data_quality_results\r\nWHERE dataset = 'pipeline_runs'\r\n  AND check_name = 'no_stuck_runs'\r\nORDER BY executed_at DESC\r\nLIMIT 1",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
